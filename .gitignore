# APIキーなどの秘密情報
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ログ
logs/*.log

# 生成された成果物（サンプルを残したい場合はコメントアウト）
output/themes/*.json
output/research/*
output/scripts/*
output/articles/*
output/slides/*
output/review/*
output/shorts/*

# .gitkeep は残す
!output/**/.gitkeep
!logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# ポイ活カンパニーの台帳・朝報（個人の利用状況が入るためコミットしない）
data/
output/poikatsu/

# 事業の実数（売上・粗利など）を含む試算は、リポジトリに入れない
products/kaitori-kit/shisan.py
products/kaitori-kit/買取率の試算.md

# オーナー個人の作業一覧（注文番号や私的なリンクを含む）は、リポジトリに入れない
pokeca/psa/todo.html

# 買取店から取得した価格データは、公開するとオーナーが決めるまでリポジトリに入れない
products/tools-site/kaitori-data/prices.json
