# =============================================================================
# .env.example
#
# このファイルを「.env」という名前でコピーして、実際のAPIキーを記入してください。
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# .env は .gitignore で除外されており、GitHubには公開されません。
# =============================================================================

# 【必須】Anthropic Claude APIキー
#   取得方法: https://console.anthropic.com/ にログイン → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【任意・推奨】Tavily 検索APIキー
#   設定すると高品質なWeb検索が使えます（未設定でもフォールバック検索で動きます）
#   取得方法: https://app.tavily.com/ で無料登録 → API Keys からコピー
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# ポイ活カンパニー（python -m poikatsu）用。すべて任意です。
# =============================================================================
# 案内メールの読み取り（読み取り専用）。Gmail は「アプリ パスワード」を使います。
POIKATSU_IMAP_HOST=imap.gmail.com
POIKATSU_IMAP_USER=
POIKATSU_IMAP_PASSWORD=
# 朝報のメール送信
POIKATSU_SMTP_HOST=smtp.gmail.com
POIKATSU_SMTP_USER=
POIKATSU_SMTP_PASSWORD=
POIKATSU_REPORT_TO=
