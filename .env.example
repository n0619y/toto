# =============================================================================
# .env.example
#
# このファイルを「.env」という名前でコピーして、実際のAPIキーを記入してください。
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# .env は .gitignore で除外されており、GitHubには公開されません。
# =============================================================================

# 【必須】Anthropic Claude APIキー
#   取得方法: https://console.anthropic.com/ にログイン → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【任意・推奨】Tavily 検索APIキー
#   設定すると高品質なWeb検索が使えます（未設定でもフォールバック検索で動きます）
#   取得方法: https://app.tavily.com/ で無料登録 → API Keys からコピー
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
