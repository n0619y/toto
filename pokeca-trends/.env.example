# ===== Claude API（要約・感情分析・買取表画像読取）=====
ANTHROPIC_API_KEY=sk-ant-xxxx

# ===== Reddit（https://www.reddit.com/prefs/apps で "script" アプリを作成）=====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pokeca-trends/0.1 (by u/your_reddit_name)

# ===== X（X Developer Portal。検索APIは有料プランが必要）=====
X_BEARER_TOKEN=

# ===== Threads（Meta開発者アプリ。threads_keyword_search 権限が必要）=====
THREADS_ACCESS_TOKEN=

# ===== Instagram（ビジネス/クリエイターアカウント + Instagram Graph API）=====
IG_ACCESS_TOKEN=
IG_USER_ID=

# ===== 自動投稿（config/settings.yaml の autopost.enabled: true で有効）=====
# X: Developer Portal でアプリの権限を "Read and write" にしてから Access Token を発行（OAuth 1.0a）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Threads: threads_content_publish / threads_manage_insights / threads_read_replies 権限付きのトークン（上の THREADS_ACCESS_TOKEN を共用）
THREADS_USER_ID=
